  "lang_name": "客家话（粤台、粤中、惠州、汀州、宁龙、于桂、铜桂等片）",
  "lang_short": "客家话",
  "roman_scheme": "通行拉丁化近似转写（非严格音位标音；精确记音见来源词典）",
  "sources": [
    "《梅县方言词典》（黄雪贞，江苏教育出版社 1995，《现代汉语方言大词典》分卷本（李荣 主编，江苏教育出版社））",
    "《于都方言词典》（谢留文，江苏教育出版社 1998）",
    "《东莞方言词典》（詹伯慧、陈晓锦，江苏教育出版社 1997）",
    "《中国语言地图集（第2版）·汉语方言卷》（中国社会科学院语言研究所等，商务印书馆 2012）"
  ],
  "coverage_note": "本表共 23 条（置信度 high 16 / mid 4 / low 3）。客家话内部相对一致，本表以梅县话为准，于都（赣南）、东莞（粤中）两片差异已在 note 中标注。",
  "grammar_qa": {
    "古音保留": "客家话保留大量中古音特征：有入声（收［-p］［-t］［-k］）、无撮口呼、古全浊声母清化后无论平仄多读送气（「病」「白」读送气），因此常被称作「中古汉语的活化石」之一。",
    "声调": "梅县话有六个单字调（阴平44、阳平11、上声31、去声53、阴入21、阳入5），平声与入声各分阴阳，上声、去声不分。",
    "人称": "第一人称单数读 ŋai（民间多写作「涯」），第三人称用「佢」，复数加「兜」等后缀。",
    "否定": "「唔」表一般否定（唔系＝不是），「冇」表存在否定（没有），另有「唔曾」表「还没……过」。",
    "词汇": "客家话有若干标志性特征词：「屋下」（家）、「禾」（稻子）、「食」（吃）、「行」（走），与粤语、闽语共享部分古语层次。"
  },
