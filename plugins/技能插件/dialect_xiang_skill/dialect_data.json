  "lang_name": "湘语（长益、娄邵、吉溆、辰溆等片；含新湘语与老湘语）",
  "lang_short": "湘语",
  "roman_scheme": "通行拉丁化近似转写（非严格音位标音；精确记音见来源词典）",
  "sources": [
    "《长沙方言词典》（鲍厚星、崔振华、沈若云、伍云姬，江苏教育出版社 1993，《现代汉语方言大词典》分卷本（李荣 主编，江苏教育出版社））",
    "《娄底方言词典》（颜清徽、刘丽华，江苏教育出版社 1994）",
    "《中国语言地图集（第2版）·汉语方言卷》（中国社会科学院语言研究所等，商务印书馆 2012）"
  ],
  "coverage_note": "本表共 24 条（置信度 high 17 / mid 6 / low 1）。湘语分新、老两派：新湘语（长沙）浊音已清化，老湘语（娄底、双峰）保留全浊声母。本表以长沙话为准，老湘语词条另注。",
  "grammar_qa": {
    "新老湘语": "湘语分两派：新湘语（长沙、益阳）全浊声母已清化且不送气；老湘语（娄底、双峰、湘乡）**保留中古全浊声母**，与吴语类似。这是湘语内部最大的分界。",
    "声调": "长沙话有六个单字调（阴平33、阳平13、上声41、阴去45、阳去21、入声24），入声自成一调但无塞音尾，只读短调。",
    "入声": "湘语保留入声**调类**，但已失去［-p］［-t］［-k］塞音韵尾（老湘语部分点例外），属「入声舒化」型，与吴语、粤语保留塞音尾的入声不同。",
    "人称": "第三人称用「他」而非「佢」，这一点与赣语、客家话、粤语都不同，是湘语的辨识特征之一。",
    "词汇": "「堂客」（妻子）、「呷」（吃）、「么子」（什么）、「何解」（为什么）是长沙话辨识度最高的几个词。"
  },
