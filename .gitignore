# ===== 预训练模型权重（体积大，需单独下载，勿提交）=====
*.safetensors
*.pth
*.pt
*.ckpt
*.bin
*.gguf
*.ggml
# MDX-NET 人声分离 ONNX 权重（models/mdx/，约 30-65MB/个，见 scripts/fetch_mdx_models）
*.onnx

# ===== 虚拟环境 / 依赖 =====
venv/
env/
.venv/
ENV/

# ===== 敏感凭证 =====
credentials.json
# AI 导演层（LLM 内核）配置，含 API Key —— 提交它会直接泄露密钥
llm_config.json
api_key.txt

# ===== 运行时数据（生成/上传/缓存）=====
outputs/
uploads/
voice_packs/
prepared/
# 训练样本库（音频 + 文本对，体积大且是本机私有素材）
training_data/
.pipcache/
.tmp/
# AI 导演层的磁盘缓存（按文本哈希存放，非源码）
_llm_cache/

# ===== 插件 =====
# 运行期插件配置（含用户私有设置，勿提交；模板见 plugins_config.json.example）
plugins_config.json
# 插件私有数据目录（由 PluginContext.data_dir 提供）
plugins_data/
# 插件位置（结构约定：plugins/技能插件/ 与 plugins/拓展插件/ 两个子区，
# 见 plugins/README.md）。子区名是中文，不能用 Python 标识符导入，
# 测试通过 core/tests/_plugin_path.py 构造命名空间包来加载。
#
# ⚠️ 随仓库发布的插件（方言系列、example_gain 等）是**要提交**的，
#    所以这里**不能**写 `plugins/*/` 之类的整目录忽略：
#    git 的目录级 ignore 匹配到中文子区后会连内容一起吞掉，
#    表现是"插件明明建好了，git status 里却什么都没有"。
#    只忽略单个插件的运行期产物即可。
plugins/**/*.wav
plugins/**/*.mp3
plugins/**/*.m4a
plugins/**/*.flac
plugins/**/__pycache__/
*.wav
*.mp3
*.m4a
*.flac

# ===== 日志 =====
*.log
server_error.log

# ===== Python 缓存 =====
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/

# ===== 测试 / 覆盖率 =====
.pytest_cache/
.coverage
htmlcov/
__pycache__/
*.pyc

# ===== IDE / 编辑器 =====
.vscode/
.idea/
*.swp
*.swo

# ===== 操作系统 =====
.DS_Store
Thumbs.db
Desktop.ini

# ===== 其他临时文件 =====
*.tmp
*.bak
*.orig
