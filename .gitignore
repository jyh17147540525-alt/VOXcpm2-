# ===== 预训练模型权重（体积大，需单独下载，勿提交）=====
*.safetensors
*.pth
*.pt
*.ckpt
*.bin
*.gguf
*.ggml
# MDX-NET 人声分离 ONNX 权重（models/mdx/，约 30-65MB/个，见 scripts/fetch_mdx_models）
*.onnx

# ===== 虚拟环境 / 依赖 =====
venv/
env/
.venv/
ENV/

# ===== 敏感凭证 =====
credentials.json
# AI 导演层（LLM 内核）配置，含 API Key —— 提交它会直接泄露密钥
llm_config.json
api_key.txt

# ===== 运行时数据（生成/上传/缓存）=====
outputs/
uploads/
voice_packs/
prepared/
.pipcache/
.tmp/
# AI 导演层的磁盘缓存（按文本哈希存放，非源码）
_llm_cache/

# ===== 插件 =====
# 运行期插件配置（含用户私有设置，勿提交；模板见 plugins_config.json.example）
plugins_config.json
# 插件私有数据目录（由 PluginContext.data_dir 提供）
plugins_data/
# 自家插件放这里（示例插件 plugins/example_gain/ 是有意提交的模板，故不整目录忽略）
plugins/*/
!plugins/example_gain/
*.wav
*.mp3
*.m4a
*.flac

# ===== 日志 =====
*.log
server_error.log

# ===== Python 缓存 =====
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/

# ===== 测试 / 覆盖率 =====
.pytest_cache/
.coverage
htmlcov/
__pycache__/
*.pyc

# ===== IDE / 编辑器 =====
.vscode/
.idea/
*.swp
*.swo

# ===== 操作系统 =====
.DS_Store
Thumbs.db
Desktop.ini

# ===== 其他临时文件 =====
*.tmp
*.bak
*.orig
